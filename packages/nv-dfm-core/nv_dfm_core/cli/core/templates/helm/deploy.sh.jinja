set -e

# Initialize values arguments
RELEASE={{ provision.helm.name | shellquote }}
VALUES_ARGS=()
INSTALL=false
UNINSTALL=false
HELM_ARGS=()

# Process command line value files
while [[ $# -gt 0 ]]; do
    case $1 in
        -f|--values)
            if [[ $# -lt 2 ]]; then
                echo "Missing file for $1" >&2
                exit 1
            fi
            VALUE_FILE=$(realpath -- "$2")
            VALUES_ARGS+=(--values "$VALUE_FILE")
            shift 2
            ;;
        -u|--uninstall)
            UNINSTALL=true
            shift
            ;;
        -i|--install)
            INSTALL=true
            shift
            ;;
        --)
            shift
            # Collect all remaining arguments for helm
            HELM_ARGS=("$@")
            break
            ;;
        *)
            echo "Unknown option: $1"
            echo "Usage: $0 [-i|--install] [-u|--uninstall] [-f|--values FILE] [-- HELM_ARGS...]"
            exit 1
            ;;
    esac
done

if [[ "$INSTALL" == false && "$UNINSTALL" == false ]]; then
    echo "No action requested, exiting"
    exit 0
fi

{% if provision.helm.namespace %}
NAMESPACE_ARGS=(--namespace {{ provision.helm.namespace | shellquote }})
CREATE_NAMESPACE_ARGS=(--create-namespace)
{% else %}
# No namespace specified, use default namespace
NAMESPACE_ARGS=()
CREATE_NAMESPACE_ARGS=()
{% endif %}
# Uninstall if requested
if [[ "$UNINSTALL" == true ]]; then
    echo "Uninstalling existing release..."
    helm uninstall "$RELEASE" --ignore-not-found "${NAMESPACE_ARGS[@]}"
fi

# Clean up old secrets
{% for server_site in server_sites %}
if kubectl "${NAMESPACE_ARGS[@]}" get secret {{ ('flare-workspace-' ~ server_site ~ '-init') | shellquote }} &> /dev/null; then
    kubectl "${NAMESPACE_ARGS[@]}" delete secret {{ ('flare-workspace-' ~ server_site ~ '-init') | shellquote }}
fi
{% endfor %}
{% for client_site in client_sites %}
if kubectl "${NAMESPACE_ARGS[@]}" get secret {{ ('flare-workspace-' ~ client_site ~ '-init') | shellquote }} &> /dev/null; then
    kubectl "${NAMESPACE_ARGS[@]}" delete secret {{ ('flare-workspace-' ~ client_site ~ '-init') | shellquote }}
fi
{% endfor %}

# If we are only uninstalling, exit here
if [[ "$UNINSTALL" == true && "$INSTALL" == false ]]; then
    echo "Only uninstallation requested, exiting"
    exit 0
fi

{% for server_site in server_sites %}
{% if provision.helm.startup_package_source == "workspace" %}
SERVER_PACKAGE_PATH={{ (workspace_path ~ '/prod_00/' ~ server_site ~ '.tar.gz') | shellquote }}
{% elif provision.helm.startup_package_source == "env" %}
PACKAGE_ENV={{ ('DFM_WORKSPACE_' ~ server_sites_upper[loop.index0] ~ '_INIT_PATH') | shellquote }}
SERVER_PACKAGE_PATH="${!PACKAGE_ENV}"
{% else %}
printf 'Invalid startup package source: %s\n' {{ provision.helm.startup_package_source | shellquote }}
exit 1
{% endif %}
if [[ ! -f "$SERVER_PACKAGE_PATH" ]]; then
    echo "Server startup package not found: $SERVER_PACKAGE_PATH"
    exit 1
fi
# Create new secrets for DFM initialization
printf 'Creating secret for %s from %s\n' {{ server_site | shellquote }} "$SERVER_PACKAGE_PATH"
kubectl "${NAMESPACE_ARGS[@]}" create secret generic {{ ('flare-workspace-' ~ server_site ~ '-init') | shellquote }} --from-file="$SERVER_PACKAGE_PATH"
{% endfor %}

{% for client_site in client_sites %}
{% if provision.helm.startup_package_source == "workspace" %}
CLIENT_PACKAGE_PATH={{ (workspace_path ~ '/prod_00/' ~ client_site ~ '.tar.gz') | shellquote }}
{% elif provision.helm.startup_package_source == "env" %}
PACKAGE_ENV={{ ('DFM_WORKSPACE_' ~ client_sites_upper[loop.index0] ~ '_INIT_PATH') | shellquote }}
CLIENT_PACKAGE_PATH="${!PACKAGE_ENV}"
{% else %}
printf 'Invalid startup package source: %s\n' {{ provision.helm.startup_package_source | shellquote }}
exit 1
{% endif %}
if [[ ! -f "$CLIENT_PACKAGE_PATH" ]]; then
    echo "Client startup package not found: $CLIENT_PACKAGE_PATH"
    exit 1
fi
# Create new secrets for DFM initialization
printf 'Creating secret for %s from %s\n' {{ client_site | shellquote }} "$CLIENT_PACKAGE_PATH"
kubectl "${NAMESPACE_ARGS[@]}" create secret generic {{ ('flare-workspace-' ~ client_site ~ '-init') | shellquote }} --from-file="$CLIENT_PACKAGE_PATH"
{% endfor %}


# Deploy the Helm chart
cd "$(dirname "$0")"

printf 'Installing %s from %s\n' "$RELEASE" "$RELEASE"
helm upgrade --install "$RELEASE" "$RELEASE" "${NAMESPACE_ARGS[@]}" "${CREATE_NAMESPACE_ARGS[@]}" "${VALUES_ARGS[@]}" "${HELM_ARGS[@]}"


